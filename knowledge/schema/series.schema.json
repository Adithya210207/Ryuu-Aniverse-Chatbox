{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aniverse/series.schema.json",
  "title": "Ryuu Aniverse series sheet",
  "description": "knowledge/series/<id>.json. Plan section 7.3. One per series (41), shared by every character from that series so facts never clash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "native_title", "status", "source", "world", "power_system", "places", "groups", "terms", "timeline",
               "shared_canon_events", "characters_in_app", "verify", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 2, "maxLength": 80, "description": "Shown in prompts as {series_title}" },
    "native_title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "status": { "enum": ["finished", "ongoing", "hiatus"] },
    "source": { "type": "string", "minLength": 5, "maxLength": 160, "description": "Which original (manga / light novel / visual novel) the snapshots follow, and its end point or latest arc" },
    "world": { "type": "string", "minLength": 80, "maxLength": 700, "description": "3-5 sentences: setting, era, tone" },
    "power_system": { "type": "string", "maxLength": 600, "description": "How powers work; empty string if none" },
    "places": { "type": "array", "minItems": 2, "maxItems": 15,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "line"],
        "properties": { "name": { "type": "string" }, "line": { "type": "string", "maxLength": 160 } } } },
    "groups": { "type": "array", "maxItems": 15,
      "items": { "type": "object", "additionalProperties": false, "required": ["name", "line"],
        "properties": { "name": { "type": "string" }, "line": { "type": "string", "maxLength": 160 } } } },
    "terms": { "type": "array", "minItems": 3, "maxItems": 40,
      "description": "Glossary used for keyword lore lookup: when a term is in the user's message, its line goes into the prompt",
      "items": { "type": "object", "additionalProperties": false, "required": ["term", "line"],
        "properties": {
          "term": { "type": "string", "minLength": 2, "maxLength": 40 },
          "aliases": { "type": "array", "maxItems": 4, "items": { "type": "string" } },
          "line": { "type": "string", "minLength": 10, "maxLength": 200 } } } },
    "timeline": { "type": "array", "minItems": 2, "maxItems": 30,
      "items": { "type": "object", "additionalProperties": false, "required": ["arc", "summary"],
        "properties": { "arc": { "type": "string" }, "summary": { "type": "string", "maxLength": 240 } } } },
    "shared_canon_events": { "type": "array", "minItems": 5, "maxItems": 60, "uniqueItems": true, "items": { "type": "string", "minLength": 2, "maxLength": 40 },
      "description": "Lower-case keywords every character of this series accepts as real" },
    "characters_in_app": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\d{3}_[a-z0-9_]+$" }, "description": "NNN_<id> of roster characters from this series" },
    "verify": { "type": "array", "items": { "type": "string", "maxLength": 200 } },
    "sources": { "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["url", "checked"],
        "properties": { "url": { "type": "string", "pattern": "^https?://" }, "checked": { "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2}|unchecked)$", "description": "Date the page was actually opened, or 'unchecked' (written from memory; the validator warns)" } } } }
  }
}
