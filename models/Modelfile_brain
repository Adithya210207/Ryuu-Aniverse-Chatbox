# aniverse-brain: the main model that plays all 100 characters (plan section 4.1).
# A thin layer on top of the Stheno model already in Ollama (Sao10K L3-8B-Stheno-v3.2, Q8_0,
# CC BY-NC 4.0 + Llama 3 licence). No extra disk space: only these settings are stored.
# Create:  set OLLAMA_HOST=127.0.0.1:11436  then  ollama create aniverse-brain -f Modelfile_brain
# (tools\models_check.ps1 does this for you.)
FROM stheno
PARAMETER num_ctx 8192
PARAMETER temperature 0.8
PARAMETER min_p 0.05
PARAMETER top_p 0.95
PARAMETER repeat_penalty 1.1
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
